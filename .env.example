# انسخ هذا الملف إلى .env أو اضبط المتغيرات في لوحة الاستضافة
NODE_ENV=production
PORT=3000
# 32 حرفاً أو أكثر: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# الحد الأقصى لأعضاء الغرفة (افتراضي 10)
MAX_ROOM_MEMBERS=10
# الحد الأقصى للغرف المفتوحة في الذاكرة (افتراضي 1000)
MAX_ROOMS=1000
